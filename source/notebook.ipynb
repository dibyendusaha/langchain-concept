   "source": [
    "from components import Components\n",
    "\n",
    "labels = [\"billing\", \"claims\", \"complaint\", \"general_query\"]\n",
    "x = Components()\n",
    "\n",
    "df = x._load_file()\n",
    "\n",
    "cdf = x._classification(df=df, labels=labels)\n",
    "\n",
    "edf = x._evaluation(df=cdf)\n",
    "\n",
    "frdf = x._report_generation(edf)\n",
    "\n",
    "print(frdf)"
   ]
  }
